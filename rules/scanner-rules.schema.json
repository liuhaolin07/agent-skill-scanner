{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/liuhaolin07/agent-skill-scanner/blob/main/rules/scanner-rules.schema.json",
  "title": "scanner-rules.json",
  "description": "Single source of truth for agent-skill-scanner detection rules (shared by the Node and Python engines).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "category", "severity", "title", "why", "remediation", "case_insensitive", "patterns"],
    "additionalProperties": true,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "description": "Unique rule id, e.g. SHELL_EXECUTION."
      },
      "category": {
        "type": "string",
        "enum": [
          "secret_access",
          "shell_execution",
          "suspicious_download",
          "network_access",
          "memory_modification",
          "excessive_permissions"
        ]
      },
      "severity": {
        "type": "string",
        "enum": ["info", "low", "medium", "high", "critical"]
      },
      "title": { "type": "string" },
      "why": { "type": "string", "description": "Why the pattern is dangerous (shown in reports)." },
      "remediation": { "type": "string", "description": "How to fix a finding (shown in reports)." },
      "case_insensitive": { "type": "boolean" },
      "patterns": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "description": "ECMAScript regex, compiled with the 'i' flag when case_insensitive is true." }
      }
    }
  }
}
